#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo1 {
            bindings = <&pastecommaspace>;
            key-positions = <39 24 10>;
        };

        combo2 {
            bindings = <&shortpass>;
            key-positions = <10 11 12 13 17>;
        };

        combo3 {
            bindings = <&longpass>;
            key-positions = <12 13 10 11 17 18 19 20>;
        };

        combo4 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <18 17>;
        };

        combo5 {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <23 24>;
        };

        combo6 {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <29 30>;
        };

        combo7 {
            bindings = <&kp NON_US_BACKSLASH>;
            key-positions = <4 5>;
        };

        combo8 {
            bindings = <&kp PIPE>;
            key-positions = <14 15>;
        };

        combo9 {
            bindings = <&kp ENTER>;
            key-positions = <19 20>;
        };

        combo10 {
            bindings = <&mo 5>;
            key-positions = <11 12>;
        };
    };

    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <180>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            tapping-term-ms = <300>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };
    };

    macros {
        shortpass: shortpass {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(N) &kp U &kp M &kp E &kp N &kp O &kp R &kp I &kp A &kp N &kp O &kp S &kp N1 &kp EXCL>;
            label = "SHORTPASS";
        };

        longpass: longpass {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(N) &kp U &kp M &kp E &kp N &kp O &kp R &kp I &kp A &kp N &kp O &kp S &kp N1 &kp EXCL &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9>;
            label = "LONGPASS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            bindings = <
&kp Q    &kp W    &kp E         &kp R  &kp T                                               &kp Y        &kp U  &kp I      &kp O       &kp P
&kp A    &kp S    &kp D         &kp F  &kp G                            &kp HOME           &kp H        &kp J  &kp K      &kp L       &kp BACKSPACE
&kp Z    &kp X    &kp C         &kp V  &kp B        &mo 4               &kp END            &kp N        &kp M  &kp COMMA  &kp PERIOD  &kp ENTER
&kp TAB  &kp TAB  &kp LEFT_GUI  &mo 3  &lt 2 SPACE  &kp LEFT_SHIFT      &kp RIGHT_CONTROL  &lt 1 SPACE                                &kp LEFT_GUI
            >;

            sensor-bindings = <&scroll_up_down>;
            display-name = "BASE";
        };

        NAV {
            bindings = <
&kp ESCAPE    &kp NUMBER_2  &kp NUMBER_3     &kp PRINTSCREEN    &kp K_CALCULATOR                      &kp NUMBER_6      &kp N7    &kp N8        &kp DELETE         &kp SPACE
&kp TAB       &kp LEFT_ALT  &kp LEFT_SHIFT   &kp LEFT_CONTROL   &kp CAPSLOCK                  &trans  &kp LEFT          &kp DOWN  &kp UP_ARROW  &kp RIGHT          &kp BACKSPACE
&kp LEFT_WIN  &kp K_MUTE    &kp C_VOLUME_UP  &kp K_VOLUME_DOWN  &kp K_PLAY_PAUSE  &trans      &trans  &kp LC(LG(LEFT))  &kp HOME  &kp END       &kp LG(LC(RIGHT))  &kp ENTER
&trans        &trans        &trans           &trans             &trans            &trans      &trans  &trans                                                       &trans
            >;

            sensor-bindings = <&scroll_up_down>;
            display-name = "NAV";
        };

        NUM {
            bindings = <
&kp F6   &kp F7        &kp F8          &kp F9            &kp F10                         &kp COMMA  &kp N7        &kp N8        &kp N9        &kp PERIOD
&kp TAB  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp F12              &kp SLASH  &kp N0     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp DELETE
&kp F1   &kp F2        &kp F3          &kp F4            &kp F5   &trans      &kp MINUS  &kp EQUAL  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER
&kp F11  &trans        &trans          &trans            &trans   &trans      &trans     &trans                                               &trans
            >;

            sensor-bindings = <&scroll_up_down>;
            display-name = "NUM";
        };

        MOUSE {
            bindings = <
&trans     &trans     &trans       &trans         &trans                      &trans         &trans    &trans    &trans    &trans
&mo 5      &mkp MB1   &kp PAGE_UP  &kp PAGE_DOWN  &trans              &trans  &kp LC(C)      &mkp MB1  &mkp MB3  &mkp MB2  &trans
&kp LC(A)  &kp K_CUT  &kp K_COPY   &kp K_PASTE    &trans  &trans      &trans  &kp LS(LC(V))  &mkp MB4  &trans    &mkp MB5  &trans
&trans     &trans     &trans       &trans         &trans  &trans      &trans  &trans                                       &trans
            >;

            sensor-bindings = <&scroll_up_down>;
            display-name = "MOUSE";
        };

        BT {
            bindings = <
&kp F1  &trans  &trans  &trans  &trans                              &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans
&trans  &trans  &trans  &trans  &trans              &bt BT_CLR      &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &trans                                                  &bootloader
            >;

            sensor-bindings = <&scroll_up_down>;
            display-name = "BT";
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
            display-name = "SCROLL";
        };

        SYM {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH        &kp DOLLAR        &kp PERCENT                      &kp LCTRL  &kp AMPERSAND         &kp ASTERISK           &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp TAB          &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &trans                   &trans  &trans     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans                &kp BACKSPACE
&trans           &trans        &trans          &trans            &trans       &trans      &trans  &trans     &trans                &trans                 &trans                &kp SLASH
&trans           &trans        &trans          &trans            &trans       &trans      &trans  &trans                                                                        &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        trilayer-symbol {
            if-layers = <1 2>;
            then-layer = <6>;
        };
    };
};
